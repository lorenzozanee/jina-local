# jina-local 环境变量模板
# 复制为 .env 后按需修改

# MCP Gateway
MCP_PORT=3000
MCP_HOST=0.0.0.0

# 模型配置（本地路径或 HF ID，显存预算 RTX 5070 12GB）
EMBEDDINGS_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 是否启用量化 / 半精度
MODEL_DTYPE=float16
MODEL_DEVICE=cuda

# Search / Reader
SEARCH_PROVIDER=searxng
READER_TIMEOUT=30

# 缓存（遵循项目规范使用 /tmp/opencode）
CACHE_DIR=/tmp/opencode/jina-local
