# jina-local 环境变量模板
# 复制为 .env 后按需修改

# MCP Gateway
MCP_PORT=3000
MCP_HOST=0.0.0.0

# 模型配置（本地路径或 HF ID，显存预算 RTX 5070 12GB）
EMBEDDINGS_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 是否启用量化 / 半精度
MODEL_DTYPE=float16
MODEL_DEVICE=cuda

# Search / Reader
SEARCH_PROVIDER=searxng
SEARXNG_PORT=8081
SEARXNG_URL=http://127.0.0.1:8081
# Required for the search profile; the SearXNG wrapper refuses a blank value.
JINA_LOCAL_SEARCH_PROXY_URL=
JINA_LOCAL_SEARCH_READINESS_QUERY=OpenCode docs
JINA_LOCAL_SEARCH_FETCHER_URL=http://127.0.0.1:8082
SEARCH_FETCHER_PORT=8082
JINA_LOCAL_SEARCH_CORE_URL=http://127.0.0.1:8083
JINA_LOCAL_SEARCH_CACHE_TTL_SECONDS=300
JINA_LOCAL_SEARCH_IDLE_SECONDS=600
JINA_LOCAL_SEARCH_START_TIMEOUT_SECONDS=30
JINA_LOCAL_LLM_BASE_URL=
JINA_LOCAL_LLM_MODEL=
JINA_LOCAL_LLM_API_KEY=
JINA_LOCAL_LLM_TIMEOUT_SECONDS=20
READER_TIMEOUT=30
CRAWL4AI_API_TOKEN=replace-with-a-random-secret

# 按需加载（减少常驻内存 50%，模型首次调用才加载，闲置 30min 自动释放 via weakref）
JINA_LOCAL_LAZY_LOAD=1
JINA_LOCAL_IDLE_TIMEOUT=1800
JINA_LOCAL_USE_GPU=1
JINA_LOCAL_MAX_BATCH_TOKENS=16384

# 缓存（遵循项目规范使用 /tmp/opencode）
CACHE_DIR=/tmp/opencode/jina-local
